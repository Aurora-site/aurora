---
import Layout from "../layouts/Layout.astro";
import CityToday from "../components/blog/CityToday.astro";

const pageUrl = "https://polarlights.pro/aurora-teriberka/";
const title =
  "Северное сияние в Териберке сегодня: вероятность и Kp прямо сейчас";
const metaDescription =
  "Актуальная вероятность северного сияния и Kp-индекс в Териберке сейчас, а также когда и где смотреть сияние в этом посёлке на берегу Баренцева моря.";
const updatedISO = "2026-10-04";
const updatedDisplay = "04.10.2026";

const faq = [
  {
    q: "Сколько ехать от Мурманска до Териберки?",
    a: "Около 130 км. На машине — примерно 2–2,5 часа по трассе. На автобусе (маршрут №241 Мурманск — Териберка — Лодейное) — около 3–3,5 часов, при этом зимой рейсы иногда отменяют из-за непогоды, расписание стоит уточнять перед поездкой.",
  },
  {
    q: "Сияние видно прямо в посёлке или нужно куда-то уезжать?",
    a: "Да, Териберка — небольшой посёлок почти без собственного освещения, поэтому сияние часто можно увидеть, просто выйдя на улицу. Если хочется более широкого обзора неба без домов и построек рядом, выберите открытый участок берега — там вид ничем не закрыт.",
  },
  {
    q: "Когда лучше ехать в Териберку за северным сиянием?",
    a: "Сезон — как и во всей Мурманской области: с конца августа по апрель, когда ночи тёмные. Зимой световой день короче, поэтому и шансов увидеть сияние вечером и ночью больше.",
  },
  {
    q: "Можно совместить поездку с осмотром «кладбища кораблей» и съёмками «Левиафана»?",
    a: "Да, это одна из причин, почему Териберка стала популярным направлением. Днём можно посмотреть локации фильма и побережье, а вечером — наблюдать северное сияние. Рекомендуем ехать на несколько дней, чтобы было время и на то, и на другое, и на запасной вечер, если первый окажется облачным.",
  },
];

const relatedLinks = [
  { href: "/blog/aurora-murmansk", label: "Северное сияние в Мурманске" },
  { href: "/blog/aurora-map", label: "Карта северного сияния онлайн" },
  { href: "/blog/kp-index", label: "KP-индекс: что это такое" },
  { href: "/blog/about-aurora", label: "Северное сияние" },
];
---

<Layout title={title} description={metaDescription} variant="blog">
  <CityToday
    pageUrl={pageUrl}
    title={title}
    metaDescription={metaDescription}
    updatedISO={updatedISO}
    updatedDisplay={updatedDisplay}
    lat={69.2}
    long={35.2}
    cityName="Териберка"
    locationLabel="в Териберке"
    heroAnswer="Коротко: Териберка — посёлок на берегу Баренцева моря примерно в 130 км от Мурманска, без городской засветки, поэтому это одно из самых удобных мест региона для наблюдения северного сияния. Актуальную вероятность и Kp-индекс на эту минуту смотрите в блоке ниже."
    breadcrumbCurrent="Северное сияние в Териберке сегодня"
    faq={faq}
    relatedLinks={relatedLinks}
  >
    <h2>Почему именно Териберка</h2>
    <p>
      Териберка находится севернее Мурманска, прямо на берегу Баренцева моря, и
      известна на весь мир как место съёмок фильма Андрея Звягинцева «Левиафан»
      (2014) — сюда до сих пор едут и за кино-локациями, и за знаменитым
      «кладбищем кораблей» на берегу. Но для наблюдения северного сияния у
      посёлка есть и практическое преимущество: это небольшое поселение почти
      без собственной городской засветки, а открытый морской горизонт даёт
      широкий обзор неба.
    </p>

    <h2>Как добраться</h2>
    <p>
      От Мурманска до Териберки — около 130 км. На автомобиле дорога занимает
      примерно 2–2,5 часа, на автобусе (рейс №241) — около 3–3,5 часов. Автобусы
      ходят по расписанию, которое меняется по сезону, а зимой рейсы иногда
      отменяют из-за непогоды — маршрут и время в пути стоит уточнять перед
      поездкой.
    </p>

    <h2>Где смотреть в Териберке</h2>
    <p>
      Благодаря минимальной засветке сияние видно прямо в посёлке. Особенно там,
      где горизонт открыт почти на 360 градусов и ничто не закрывает небо.
    </p>

    <h2>Когда сегодня лучше смотреть</h2>
    <p>
      Ориентируйтесь на вероятность и Kp-индекс в блоке выше — они обновляются в
      реальном времени. Главное условие помимо активности — чистое небо: даже
      при высокой вероятности плотная облачность может скрыть сияние. Смотреть
      лучше после того, как стемнеет, и быть готовым подождать: яркие вспышки
      могут появиться не сразу.
    </p>
    <p>
      <a
        href="/#map"
        onclick='try{localStorage.setItem("city:",JSON.stringify({name:"Териберка",name_ru:"Териберка",lat:69.2,long:35.2}))}catch(e){}'
        >Смотреть карту с вероятностью, Kp и облачностью →</a
      >
    </p>

    <h2>Практические советы</h2>
    <ul>
      <li>
        Одевайтесь теплее, чем кажется нужным — на открытом морском побережье
        холодный ветер ощущается сильнее.
      </li>
      <li>
        Дайте глазам 10–15 минут привыкнуть к темноте, прежде чем решить, что
        сияния нет.
      </li>
      <li>
        Возьмите камеру или телефон со штативом — длинная выдержка показывает
        сияние даже тогда, когда глазом оно едва заметно.
      </li>
      <li>
        Планируйте поездку на несколько дней: если один вечер окажется облачным,
        останется запасной.
      </li>
    </ul>
  </CityToday>
</Layout>
