---
import Layout from "../layouts/Layout.astro";
import CityToday from "../components/blog/CityToday.astro";

const pageUrl = "https://polarlights.pro/aurora-apatity/";
const title =
  "Северное сияние в Апатитах сегодня: вероятность и Kp прямо сейчас";
const metaDescription =
  "Актуальная вероятность северного сияния и Kp-индекс в Апатитах сейчас, а также когда и где смотреть сияние в этом городе у Хибинских гор.";
const updatedISO = "2026-10-28";
const updatedDisplay = "28.10.2026";

const faq = [
  {
    q: "Сколько ехать от Мурманска до Апатитов?",
    a: "Около 190–200 км. На машине дорога занимает примерно 3 часа, на поезде или автобусе — от 3,5 до 4,5 часов. Из Москвы и Санкт-Петербурга до Апатитов можно долететь или доехать на поезде напрямую — подробнее в разделе «Как добраться».",
  },
  {
    q: "Насколько хорошо в Апатитах видно северное сияние?",
    a: "Апатиты стоят у подножия Хибинских гор и благодаря умеренной застройке сохраняют достаточно тёмные участки неба — световое загрязнение здесь не такое сильное, как в крупных городах, и при высокой геомагнитной активности сияние хорошо видно даже в городской черте. Но мы всё же советуем отъехать от центральных освещённых улиц к окраине или в сторону открытой местности за городом — там меньше засветки и шире обзор неба.",
  },
];

const relatedLinks = [
  { href: "/aurora-kirovsk", label: "Северное сияние в Кировске" },
  { href: "/blog/aurora-murmansk", label: "Северное сияние в Мурманске" },
  { href: "/blog/aurora-map", label: "Карта северного сияния онлайн" },
  { href: "/blog/kp-index", label: "KP-индекс: что это такое" },
];
---

<Layout title={title} description={metaDescription} variant="blog">
  <CityToday
    pageUrl={pageUrl}
    title={title}
    metaDescription={metaDescription}
    updatedISO={updatedISO}
    updatedDisplay={updatedDisplay}
    lat={67.6}
    long={33.4}
    cityName="Апатиты"
    locationLabel="в Апатитах"
    heroAnswer="Коротко: Апатиты — город у подножия Хибинских гор, примерно в 190–200 км от Мурманска, транспортные ворота региона с собственной железнодорожной станцией. Актуальную вероятность и Kp-индекс на эту минуту смотрите в блоке ниже."
    breadcrumbCurrent="Северное сияние в Апатитах сегодня"
    faq={faq}
    relatedLinks={relatedLinks}
  >
    <h2>Почему именно Апатиты</h2>
    <p>
      Апатиты стоят у подножия Хибинских гор, в 20 км от Кировска, и служат
      транспортными воротами региона — здесь проходит железная дорога, а дальше
      до Кировска можно доехать на такси за 20 минут. В городе работает Кольский
      научный центр РАН. Апатиты расположены южнее Мурманска, но благодаря
      умеренной застройке и соседству с горами здесь остаются достаточно тёмные
      участки неба для наблюдения сияния.
    </p>

    <h2>Как добраться</h2>
    <p>
      Быстрее всего — самолётом: аэропорт «Хибины» (KVK) находится в 15 км от
      Апатитов, рейсы из Москвы (Шереметьево) выполняет авиакомпания
      «Северсталь» — около 1 ч 50 мин в пути, из Санкт-Петербурга (Пулково) —
      около 1 ч 30 мин. Из аэропорта до города ходят автобус и такси.
    </p>
    <p>
      На поезде из Москвы (с Ленинградского вокзала) дорога занимает больше
      суток — около 32–35 часов, из Санкт-Петербурга (с Ладожского вокзала)
      прямой поезд идёт около суток, порядка 26 часов. Оба состава следуют
      транзитом на Мурманск через Петрозаводск и Кандалакшу, так что Апатиты —
      промежуточная станция, а не конечная.
    </p>
    <p>
      От Мурманска до Апатитов — около 190–200 км, на машине это примерно 3
      часа, поезда и автобусы идут от 3,5 до 4,5 часов. Железнодорожная станция
      «Апатиты-1» — удобная точка, откуда многие туристы добираются и в соседний
      Кировск.
    </p>

    <h2>Где смотреть в Апатитах</h2>
    <p>
      Город равнинный, поэтому стоит отъехать от центральных освещённых улиц к
      окраине или в сторону открытой местности за городом — там засветка заметно
      меньше и обзор неба шире.
    </p>

    <h2>Когда сегодня лучше смотреть</h2>
    <p>
      Смотрите на вероятность и Kp-индекс в блоке выше: поскольку Апатиты
      расположены южнее Мурманска, для яркого сияния здесь обычно нужна
      несколько более высокая активность. При ясном небе и повышенном Kp шансы
      увидеть сияние хорошие в любое время после наступления темноты. Актуальный
      прогноз и карту сияния по всему миру смотрите на
      <a href="/">главной странице</a> сайта.
    </p>

    <h2>Практические советы</h2>
    <ul>
      <li>
        Отъезжайте от освещённых центральных улиц — за городом сияние видно
        заметно лучше.
      </li>
      <li>
        Дайте глазам 10–15 минут привыкнуть к темноте, прежде чем решить, что
        сияния нет.
      </li>
      <li>
        Камера или телефон со штативом покажут сияние даже тогда, когда глазом
        оно едва различимо.
      </li>
      <li>
        Планируйте поездку на несколько дней, чтобы было запасное время на
        случай облачности.
      </li>
    </ul>
  </CityToday>
</Layout>
