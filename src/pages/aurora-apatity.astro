---
import Layout from "../layouts/Layout.astro";
import CityToday from "../components/blog/CityToday.astro";

const pageUrl = "https://polarlights.pro/aurora-apatity/";
const title =
  "Северное сияние в Апатитах сегодня: вероятность и Kp прямо сейчас";
const metaDescription =
  "Актуальная вероятность северного сияния и Kp-индекс в Апатитах сейчас, а также когда и где смотреть сияние в этом городе у Хибинских гор.";
const updatedISO = "2026-10-04";
const updatedDisplay = "04.10.2026";

const faq = [
  {
    q: "Сколько ехать от Мурманска до Апатитов?",
    a: "Чуть меньше, чем до соседнего Кировска — около 190–200 км. На машине дорога занимает примерно 3 часа, на поезде или автобусе — от 3,5 до 4,5 часов. В Апатитах есть железнодорожная станция, через которую многие едут и в Кировск.",
  },
  {
    q: "В Апатитах сияние видно так же хорошо, как в Кировске?",
    a: "Да, города расположены совсем рядом — около 20 км друг от друга — и условия для наблюдения похожи. В Апатитах город крупнее и равнинный, поэтому для чистого обзора стоит отъехать к окраине, где меньше уличного освещения.",
  },
  {
    q: "Апатиты южнее Мурманска — сияние там хуже видно?",
    a: "Апатиты расположены южнее Мурманска и Териберки, поэтому для яркого сияния здесь иногда нужна чуть более высокая геомагнитная активность. При повышенном Kp и ясном небе сияние видно не реже, чем севернее.",
  },
  {
    q: "Что ещё посмотреть в Апатитах помимо сияния?",
    a: "В Апатитах находится Кольский научный центр РАН, а рядом, в Кировске, — горнолыжный курорт «Большой Вудъявр» и самый северный в мире полярно-альпийский ботанический сад. Удобно совместить поездку по обоим городам.",
  },
];

const relatedLinks = [
  { href: "/aurora-kirovsk", label: "Северное сияние в Кировске" },
  { href: "/blog/aurora-murmansk", label: "Северное сияние в Мурманске" },
  { href: "/blog/aurora-map", label: "Карта северного сияния онлайн" },
  { href: "/blog/kp-index", label: "KP-индекс: что это такое" },
];
---

<Layout title={title} description={metaDescription} variant="blog">
  <CityToday
    pageUrl={pageUrl}
    title={title}
    metaDescription={metaDescription}
    updatedISO={updatedISO}
    updatedDisplay={updatedDisplay}
    lat={67.6}
    long={33.4}
    cityName="Апатиты"
    locationLabel="в Апатитах"
    heroAnswer="Коротко: Апатиты — город у подножия Хибинских гор, примерно в 190–200 км от Мурманска, транспортные ворота региона с собственной железнодорожной станцией. Актуальную вероятность и Kp-индекс на эту минуту смотрите в блоке ниже."
    breadcrumbCurrent="Северное сияние в Апатитах сегодня"
    faq={faq}
    relatedLinks={relatedLinks}
  >
    <h2>Почему именно Апатиты</h2>
    <p>
      Апатиты стоят у подножия Хибинских гор, в 20 км от Кировска, и служат
      транспортными воротами региона — здесь проходит железная дорога, а дальше
      до Кировска можно доехать на такси за 20 минут. В городе работает Кольский
      научный центр РАН. Как и Кировск, Апатиты расположены южнее Мурманска, но
      благодаря умеренной застройке и соседству с горами здесь остаются
      достаточно тёмные участки неба для наблюдения сияния.
    </p>

    <h2>Как добраться</h2>
    <p>
      От Мурманска до Апатитов — около 190–200 км, на машине это примерно 3
      часа. Поезда и автобусы идут от 3,5 до 4,5 часов. Железнодорожная станция
      в Апатитах — удобная точка, откуда многие туристы добираются и в соседний
      Кировск.
    </p>

    <h2>Где смотреть в Апатитах</h2>
    <p>
      Город равнинный и более крупный, чем Кировск, поэтому стоит отъехать от
      центральных освещённых улиц к окраине или в сторону открытой местности за
      городом — там засветка заметно меньше и обзор неба шире.
    </p>

    <h2>Когда сегодня лучше смотреть</h2>
    <p>
      Смотрите на вероятность и Kp-индекс в блоке выше: поскольку Апатиты
      расположены южнее Мурманска, для яркого сияния здесь обычно нужна
      несколько более высокая активность. При ясном небе и повышенном Kp шансы
      увидеть сияние хорошие в любое время после наступления темноты.
    </p>

    <h2>Практические советы</h2>
    <ul>
      <li>
        Отъезжайте от освещённых центральных улиц — за городом сияние видно
        заметно лучше.
      </li>
      <li>
        Дайте глазам 10–15 минут привыкнуть к темноте, прежде чем решить, что
        сияния нет.
      </li>
      <li>
        Камера или телефон со штативом покажут сияние даже тогда, когда глазом
        оно едва различимо.
      </li>
      <li>
        Планируйте поездку на несколько дней, чтобы было запасное время на
        случай облачности.
      </li>
    </ul>
  </CityToday>
</Layout>
