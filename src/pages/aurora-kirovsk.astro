---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CityToday from "../components/blog/CityToday.astro";
import photo1 from "../assets/moscow1.png";
import photo2 from "../assets/moscow2.png";
import photo3 from "../assets/moscow3.png";

const pageUrl = "https://polarlights.pro/aurora-kirovsk/";
const title =
  "Северное сияние в Кировске сегодня: вероятность и Kp прямо сейчас";
const metaDescription =
  "Актуальная вероятность северного сияния и Kp-индекс в Кировске сейчас, а также когда и где смотреть сияние у горнолыжного курорта в Хибинах.";
const updatedISO = "2026-10-04";
const updatedDisplay = "04.10.2026";

const faq = [
  {
    q: "Сколько ехать от Мурманска до Кировска?",
    a: "Около 205 км. На машине дорога занимает примерно 3 часа, на автобусе или поезде — от 3,5 до 4,5 часов. Поезд идёт до соседних Апатитов, а дальше до Кировска можно доехать на такси за 20 минут.",
  },
  {
    q: "Можно увидеть сияние прямо на склонах горнолыжного курорта?",
    a: "Да, вечером и ночью на склонах «Большого Вудъявра» и в окрестностях города освещение минимально по сравнению с крупным городом, поэтому сияние часто видно и там. Чем дальше от фонарей города и подъёмников — тем чище обзор.",
  },
  {
    q: "Кировск южнее Мурманска — сияние там хуже видно?",
    a: "В периоды повышенной активности сияние здесь видно не реже, а горы Хибин и малая засветка делают обзор очень комфортным. Всё же это такое же Заполярье.",
  },
  {
    q: "Когда лучше ехать в Кировск: только зимой, в сезон горнолыжного курорта?",
    a: "Сезон наблюдения сияния в Мурманской области — с конца августа по апрель, он шире горнолыжного сезона. Многие туристы совмещают катание на лыжах днём с наблюдением сияния вечером, но приехать можно и в начале осени, пока снега на склонах ещё нет.",
  },
];

const relatedLinks = [
  { href: "/aurora-apatity", label: "Северное сияние в Апатитах" },
  { href: "/blog/aurora-murmansk", label: "Северное сияние в Мурманске" },
  { href: "/blog/aurora-map", label: "Карта северного сияния онлайн" },
  { href: "/blog/kp-index", label: "KP-индекс: что это такое" },
];
---

<Layout title={title} description={metaDescription} variant="blog">
  <CityToday
    pageUrl={pageUrl}
    title={title}
    metaDescription={metaDescription}
    updatedISO={updatedISO}
    updatedDisplay={updatedDisplay}
    lat={67.6}
    long={33.7}
    cityName="Кировск"
    locationLabel="в Кировске"
    heroAnswer="Коротко: Кировск — город у подножия Хибинских гор, примерно в 205 км от Мурманска, известный горнолыжным курортом «Большой Вудъявр». Собственной городской засветки здесь немного, а горы вокруг создают естественные тёмные участки неба. Актуальную вероятность и Kp-индекс на эту минуту смотрите в блоке ниже."
    breadcrumbCurrent="Северное сияние в Кировске сегодня"
    faq={faq}
    relatedLinks={relatedLinks}
  >
    <h2>Почему именно Кировск</h2>
    <p>
      Кировск стоит у подножия гор Хибины и известен прежде всего горнолыжным
      курортом «Большой Вудъявр», а также добычей апатитовой руды, давшей
      название городу. Здесь же находится самый северный в мире
      полярно-альпийский ботанический сад. Город заметно южнее Мурманска и
      Териберки, но благодаря горному рельефу и небольшой засветке вечернее небо
      здесь остаётся достаточно тёмным для наблюдения сияния.
    </p>

    <h2>Как добраться</h2>
    <p>
      От Мурманска до Кировска — около 205 км, на машине это примерно 3 часа.
      Поезда идут до соседних Апатитов (3,5–4,5 часа в пути), а дальше до
      Кировска — около 20 минут на такси. Автобусы также связывают Мурманск с
      обоими городами.
    </p>
    <p>
      Кроме того, в Апатитах есть свой аэропорт «Хибины», куда летают самолёты
      из Москвы и Санкт-Петербурга — это самый быстрый способ добраться из
      других регионов страны. Летом иногда добавляются сезонные рейсы, например
      в Сочи и Анапу. Расписание и список направлений периодически меняются,
      поэтому актуальные рейсы и перевозчиков стоит уточнять на сайте аэропорта
      или у авиакомпаний перед поездкой.
    </p>

    <h2>Где смотреть в Кировске</h2>
    <p>
      В целом городская засветка в Кировске слабая, поэтому сияние часто видно
      прямо в городе. А если сияние слабое и неяркое, лучше выехать за город —
      туда, где небо максимально открыто и ничего не мешает обзору.
    </p>

    <h2>Когда сегодня лучше смотреть</h2>
    <p>
      Смотрите на вероятность и Kp-индекс в блоке выше: поскольку Кировск
      расположен южнее Мурманска, для яркого сияния здесь обычно нужна несколько
      более высокая активность. При ясном небе и повышенном Kp шансы увидеть
      сияние хорошие в любое время после наступления темноты.
    </p>
    <p>
      <a
        href="/#map"
        onclick='try{localStorage.setItem("city:",JSON.stringify({name:"Кировск",name_ru:"Кировск",lat:67.6,long:33.7}))}catch(e){}'
        >Смотреть карту с вероятностью, Kp и облачностью →</a
      >
    </p>

    <h2>Практические советы</h2>
    <ul>
      <li>
        Если планируете смотреть сияние после катания на лыжах, возьмите с собой
        тёплую одежду отдельно от горнолыжной — вечером на улице холоднее, чем
        на склоне днём.
      </li>
      <li>
        Дайте глазам 10–15 минут привыкнуть к темноте вдали от освещённых
        участков курорта.
      </li>
      <li>
        Камера или телефон со штативом покажут сияние даже тогда, когда глазом
        оно едва различимо.
      </li>
      <li>
        Планируйте поездку на несколько дней, чтобы было запасное время на
        случай облачности.
      </li>
    </ul>

    <Fragment slot="gallery">
      <style>
        .images {
          display: flex;
          gap: 30px;
          overflow-x: auto;
          scroll-behavior: smooth;
          margin: 10px 0 0 0;
          white-space: nowrap;
          justify-content: space-between;
          padding-bottom: 24px;
        }

        .image-slider-container {
          position: relative;
          margin: 0 auto;
          overflow: visible;
        }

        .imag {
          flex: 0 0 auto;
          width: 360px;
          position: relative;
          filter: drop-shadow(10px 10px 10px rgba(0, 0, 0, 0.8));
          border-radius: 20px;
        }

        .imag img {
          max-width: 100%;
          height: 100%;
          border-radius: 20px;
        }

        .slider-button {
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          color: black;
          border: none;
          cursor: pointer;
          padding: 5px 15px;
          z-index: 1000;
          font-size: 30px;
        }

        .slider-button.left {
          left: -50px;
          color: white;
        }

        .slider-button.right {
          right: -50px;
          color: white;
        }

        @media (max-width: 1300px) {
          .images {
            overflow-x: auto;
          }
        }

        @media (max-width: 952px) {
          .slider-button {
            display: none !important;
          }
        }
        @media (max-width: 482px) {
          .imag {
            width: 90%;
          }
        }
      </style>
      <div class="image-slider-container">
        <button class="slider-button left" id="slideLeft">&#8249;</button>
        <div class="images" id="slider">
          <div class="imag">
            <Image src={photo1} alt="Северное сияние" />
          </div>
          <div class="imag">
            <Image src={photo2} alt="Северное сияние" />
          </div>
          <div class="imag">
            <Image src={photo3} alt="Северное сияние" />
          </div>
        </div>
        <button class="slider-button right" id="slideRight">&#8250;</button>
      </div>
      <script is:inline>
        {
          function initSlider() {
            const slider = document.getElementById("slider");
            const slideLeft = document.getElementById("slideLeft");
            const slideRight = document.getElementById("slideRight");

            if (!slider) return;

            const totalWidth = Array.from(slider.children).reduce(
              (sum, item) => sum + item.offsetWidth,
              0,
            );
            const visibleWidth = slider.offsetWidth;

            if (totalWidth > visibleWidth) {
              slideLeft.style.display = "block";
              slideRight.style.display = "block";

              slideLeft.addEventListener("click", () => {
                slider.scrollBy({ left: -380, behavior: "smooth" });
              });

              slideRight.addEventListener("click", () => {
                slider.scrollBy({ left: 380, behavior: "smooth" });
              });
            } else {
              slideLeft.style.display = "none";
              slideRight.style.display = "none";
            }
          }

          window.addEventListener("load", initSlider);
          window.addEventListener("resize", initSlider);
        }
      </script>
    </Fragment>
  </CityToday>
</Layout>
