---
import { getImage, Image } from "astro:assets";
import auroraback_mb from "../assets/auroraback_mb.png";
const auroraBackMbImageUrl = `url(${(await getImage({ src: auroraback_mb })).src})`;
import auroraback from "../assets/auroraback.png";
const auroraBackImageUrl = `url(${(await getImage({ src: auroraback })).src})`;
import { ChartTabs } from "./reactive/ChartTabs";
import { ProLiveIndices } from "./reactive/ProLiveIndices";
import { useAstroTranslations } from "../i18n/utils";
const t = useAstroTranslations(Astro);

const pageUrl = "https://polarlights.pro/pro/";

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t("breadcrumbs.home"),
      item: "https://polarlights.pro/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t("pro.heading"),
      item: pageUrl,
    },
  ],
};
---

<style define:vars={{ auroraBackMbImageUrl, auroraBackImageUrl }}>
  .description h1 {
    font-family: "SongerGrotesqueBold";
    font-size: 64px;
  }

  .breadcrumbs {
    display: block;
    text-align: left;
    margin-bottom: 24px;
    font-size: 14px;
    opacity: 0.75;
  }

  .breadcrumbs a {
    opacity: 0.85;
  }

  .breadcrumbs-sep {
    margin: 0 6px;
    opacity: 0.5;
    text-decoration: none;
  }

  .breadcrumbs-current {
    opacity: 0.95;
  }

  #description {
    background-image: var(--auroraBackMbImageUrl);
  }
  @media (min-width: 768px) {
    #description {
      background-image: var(--auroraBackImageUrl);
    }
  }

  .intro {
    max-width: 720px;
    margin: 20px auto 0;
    text-align: left;
  }

  .pro-content {
    padding: 20px 0 60px;
  }

  .cta-block {
    margin: 20px 0 40px;
    padding: 20px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.06);
  }

  .live-text {
    margin-bottom: 30px;
  }

  .pro-content :global(a) {
    color: #4fd1c5;
  }

  @media (max-width: 510px) {
    .description h1 {
      line-height: 60px;
      font-size: 44px;
    }
  }
</style>

<section
  class="description bg-contain bg-[center_50px] bg-no-repeat pt-[20px] pb-5 text-center md:bg-[0px_20px] md:pt-[40px]"
  id="description"
>
  <nav class="breadcrumbs" aria-label={t("breadcrumbs.ariaLabel")}>
    <a href="/">{t("breadcrumbs.home")}</a><span class="breadcrumbs-sep">/</span
    ><span class="breadcrumbs-current">{t("pro.heading")}</span>
  </nav>
  <h1>{t("pro.heading")}</h1>
  <p class="intro" set:html={t("pro.intro")} />
</section>

<div class="pro-content">
  <div class="cta-block">
    <p set:html={t("pro.disclaimer")} />
  </div>

  <h2>{t("pro.live.title")}</h2>
  <p class="live-text">{t("pro.live.text")}</p>
  <ProLiveIndices client:only="react" />

  <h2>{t("pro.kp.title")}</h2>
  <p>{t("pro.kp.text")}</p>
  <ChartTabs client:only="react" />
</div>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
