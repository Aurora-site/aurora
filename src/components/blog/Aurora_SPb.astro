---
import { getImage, Image } from "astro:assets";
import auroraback_mb from "../../assets/auroraback_mb.png";
const auroraBackMbImageUrl = `url(${(await getImage({ src: auroraback_mb })).src})`;
import auroraback from "../../assets/auroraback.png";
const auroraBackImageUrl = `url(${(await getImage({ src: auroraback })).src})`;
import spb1 from "../../assets/aurora-spb_1.png";
import spb2 from "../../assets/aurora-spb_2.png";
import spb3 from "../../assets/aurora-spb_3.png";

const pageUrl = "https://polarlights.pro/blog/aurora-spb/";
const dateModifiedISO = "2026-09-20";
const dateModifiedDisplay = "20.09.2026";
// datePublishedISO: точная дата первой публикации статьи неизвестна,
// поэтому в articleLd она намеренно не указывается (см. ниже).

const faq = [
  {
    q: "Можно ли увидеть северное сияние в Санкт-Петербурге?",
    a: 'Да, можно. Санкт-Петербург находится на широте 59.93° с.ш. — значительно южнее Полярного круга, поэтому для наблюдений нужна высокая геомагнитная активность, с индексом Kp около 6 и выше. Следите за <a href="/#index" style="text-decoration: underline; text-underline-offset: 2px;">индексом</a>, чтобы не пропустить момент.',
  },
  {
    q: "При каком Kp-индексе видно сияние в Санкт-Петербурге?",
    a: "Нужен индекс Kp около 6 и выше. Чем выше индекс, тем ярче сияние и тем выше шанс заметить его даже при небольшой засветке.",
  },
  {
    q: "Почему в последние годы сияние в СПб видно чаще?",
    a: "В 2024 и 2025 годах, а по прогнозам и в 2026 году, Солнце особенно активно и радует охотников за сиянием сильными вспышками — поэтому мы всё чаще наблюдаем сияние в широтах значительно южнее Заполярья, в том числе в Санкт-Петербурге.",
  },
  {
    q: "Как часто обновляется прогноз для Санкт-Петербурга?",
    a: "Прогноз на 27 дней обновляется раз в неделю, обычно по понедельникам, а прогноз на 3 дня — ежедневно. Индекс, как и погода, очень изменчив, поэтому лучше ориентироваться на краткосрочный прогноз.",
  },
];

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Северное сияние в Санкт-Петербурге — прогноз и советы",
  description:
    "Можно ли увидеть северное сияние в Спб? Да! Узнайте, при каком индексе оно появляется, как следить за прогнозом и где искать сияние с Polarlights.",
  author: {
    "@type": "Person",
    name: "Надежда Горбатенко",
  },
  publisher: {
    "@type": "Organization",
    name: "Polarlights",
    url: "https://polarlights.pro",
  },
  dateModified: dateModifiedISO,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": pageUrl,
  },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a.replace(/<[^>]+>/g, ""),
    },
  })),
};
---

<style define:vars={{ auroraBackMbImageUrl, auroraBackImageUrl }}>
  #description {
    background-image: var(--auroraBackMbImageUrl);
  }
  @media (min-width: 768px) {
    #description {
      background-image: var(--auroraBackImageUrl);
    }
  }

  img {
    max-width: 100%;
    height: 100%;
    border-radius: 20px;
  }

  h2 {
    margin-top: 40px;
    margin-bottom: 10px;
    font-size: 24px;
  }
  h3 {
    margin-top: 25px;
    margin-bottom: 8px;
    font-size: 19px;
  }
  p {
    text-align: justify;
  }
  a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  ul {
    display: block;
    text-align: left;
    list-style: disc;
    padding-left: 20px;
  }
  ol {
    display: block;
    text-align: left;
    list-style: decimal;
    padding-left: 20px;
  }
  h1 {
    font-size: 64px;
  }

  .description {
    align-items: center;
    text-align: center;
  }

  .description h2 {
    font-family: "SongerGrotesqueBold";
    font-size: 24px;
    margin: 60px 0 85px 0;
  }

  .updated-badge {
    display: block;
    width: fit-content;
    margin: 14px auto 0;
    padding: 4px 14px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.12);
    font-size: 15px;
    font-weight: normal;
  }

  .author-line {
    max-width: 720px;
    margin: 20px auto 0;
    font-size: 15px;
    opacity: 0.85;
    text-align: left;
  }

  .lead-answer {
    max-width: 720px;
    margin: 20px auto 0;
    text-align: left;
  }

  .cta-block {
    margin: 20px 0 40px;
    padding: 20px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.06);
  }

  .images {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-behavior: smooth;
    margin: 10px 0 0 0;
    white-space: nowrap;
    justify-content: space-between;
    padding-bottom: 100px;
  }

  .image-slider-container {
    position: relative;
    margin: 0 auto;
    overflow: visible;
  }

  .imag {
    flex: 0 0 auto;
    width: 360px;
    position: relative;
    filter: drop-shadow(10px 10px 10px rgba(0, 0, 0, 0.8));
    border-radius: 20px;
  }

  .slider-button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    /* background: rgba(0, 0, 0, 0.5); /* Полупрозрачный фон */
    color: black;
    border: none;
    cursor: pointer;
    padding: 5px 15px;
    z-index: 1000;
    font-size: 30px;
  }

  .slider-button.left {
    left: -50px;
    color: white;
  }

  .slider-button.right {
    right: -50px;
    color: white;
  }

  @media (max-width: 510px) {
    .description h1 {
      font-size: 32px;
      line-height: 1.4;
      margin-bottom: 10px;
    }
  }

  @media (max-width: 1300px) {
    .images {
      overflow-x: auto;
    }
  }

  @media (max-width: 952px) {
    .slider-button {
      display: none !important;
    }
  }
  @media (max-width: 482px) {
    .imag {
      width: 90%;
    }
  }
</style>

<section
  class="description bg-contain bg-[center_50px] bg-no-repeat pt-[80px] pb-5 text-center md:bg-[0px_20px]"
  id="description"
>
  <h1>
    Северное сияние в Санкт-Петербурге
    <span class="updated-badge">Обновлено: {dateModifiedDisplay}</span>
  </h1>
  <p class="author-line">
    Автор: Надежда Горбатенко, разработчик Polarlights.pro — сервиса прогноза
    северного сияния. Выросла в Мурманской области и наблюдает сияние с детства.
  </p>
  <p class="lead-answer">
    Коротко: да, можно. Санкт-Петербург находится значительно южнее Полярного
    круга, поэтому сияние здесь видно не всегда, а только при высокой
    геомагнитной активности — с индексом Kp около 6 и выше.
  </p>
</section>

<div class="pt-[25px] pb-[50px]">
  <h2>Северное сияние в СПб</h2>
  <p>
    Санкт-Петербург находится на широте 59.93° с.ш., 30.31° в.д. Обычно северное
    (в нашем случае — полярное) сияние видно на широтах около и выше Полярного
    круга.
  </p>
  <p>
    Для того чтобы сияние было заметно в Санкт-Петербурге и около него,
    геомагнитная активность должна быть высокой — с индексом Kp около 6 и выше.
    За индексом можно следить <a href="/#index">здесь</a>.
  </p>
  <p>
    В 2024 и 2025 годах, а по прогнозам и в 2026 году, Солнце радует охотников
    за сиянием сильными вспышками, и мы всё чаще наблюдаем сияние в широтах,
    значительно южнее Заполярья — в том числе и в Санкт-Петербурге.
  </p>

  <h2>Как следить за прогнозом</h2>
  <div class="cta-block">
    <p>
      Прогноз на <a href="/#index">27 дней</a> обновляется раз в неделю — обычно по
      понедельникам, а <a href="/#index">прогноз на 3 дня</a> — обычно ежедневно.
      Конечно, лучше ориентироваться на краткосрочный прогноз и помнить, что индекс,
      как и погода, очень изменчив.
    </p>
  </div>

  <h2>Советы по наблюдению от Поларлайтс</h2>
  <ol>
    <li><a href="/#index">Следите за индексом</a>;</li>
    <li>
      <a href="/#map">Проверяйте вероятность</a> в вашей геолокации и на карте в целом;
    </li>
    <li>
      <a href="/#map">Учитывайте облачность</a> — через плотные облака сияние не видно;
    </li>
    <li><a href="/">Используйте Поларлайтс</a>.</li>
  </ol>

  <h2>Частые вопросы</h2>
  {
    faq.map((item) => (
      <>
        <h3>{item.q}</h3>
        <p set:html={item.a} />
      </>
    ))
  }

  <h2>Итог</h2>
  <p>
    Северное сияние в Санкт-Петербурге — не миф, а реальность при достаточно
    высокой геомагнитной активности. Следите за индексом и вероятностью,
    учитывайте облачность — и однажды небо над городом подарит вам настоящее
    полярное сияние.
  </p>

  <h2>И будет вам сияние!</h2>

  <div class="mt-[60px] mb-[50px] text-left">
    <a
      class="font-[SongerGrotesqueBold] text-[24px] font-bold underline underline-offset-2"
      href="/blog">В блог о северном сиянии</a
    >
  </div>
  <div class="pb-[50px] text-left">
    <a
      class="font-[SongerGrotesqueBold] text-[24px] font-bold underline underline-offset-2"
      href="/">Перейти на главную страницу с картой и вероятностью</a
    >
  </div>

  <div class="image-slider-container">
    <button class="slider-button left" id="slideLeft">&#8249;</button>
    <div class="images" id="slider">
      <div class="imag">
        <Image
          src={spb1}
          alt="Зелёное северное сияние над многоэтажными жилыми домами"
        />
      </div>
      <div class="imag">
        <Image src={spb2} alt="Северное сияние над тёмным ночным пейзажем" />
      </div>
      <div class="imag">
        <Image
          src={spb3}
          alt="Зелёное северное сияние с лёгкой городской засветкой у горизонта"
        />
      </div>
    </div>
    <button class="slider-button right" id="slideRight">&#8250;</button>
  </div>

  <script is:inline>
    {
      function initSlider() {
        const slider = document.getElementById("slider");
        const slideLeft = document.getElementById("slideLeft");
        const slideRight = document.getElementById("slideRight");

        if (!slider) return;

        const totalWidth = Array.from(slider.children).reduce(
          (sum, item) => sum + item.offsetWidth,
          0,
        );
        const visibleWidth = slider.offsetWidth;

        if (totalWidth > visibleWidth) {
          slideLeft.style.display = "block";
          slideRight.style.display = "block";

          slideLeft.addEventListener("click", () => {
            slider.scrollBy({ left: -380, behavior: "smooth" });
          });

          slideRight.addEventListener("click", () => {
            slider.scrollBy({ left: 380, behavior: "smooth" });
          });
        } else {
          slideLeft.style.display = "none";
          slideRight.style.display = "none";
        }
      }

      window.addEventListener("load", initSlider);
      window.addEventListener("resize", initSlider);
    }
  </script>
</div>

<script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
