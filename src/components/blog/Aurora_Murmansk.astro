---
import { getImage, Image } from "astro:assets";
import auroraback_mb from "../../assets/auroraback_mb.png";
const auroraBackMbImageUrl = `url(${(await getImage({ src: auroraback_mb })).src})`;
import auroraback from "../../assets/auroraback.png";
const auroraBackImageUrl = `url(${(await getImage({ src: auroraback })).src})`;
import mmsk1 from "../../assets/aurora-Murmansk-1.png";
import mmsk2 from "../../assets/aurora-Murmansk-2.png";
import mmsk3 from "../../assets/aurora-Murmansk-3.png";

const pageUrl = "https://polarlights.pro/blog/aurora-murmansk/";
const dateModifiedISO = "2026-09-07";
const dateModifiedDisplay = "07.09.2026";
// datePublishedISO: точная дата первой публикации статьи неизвестна,
// поэтому в articleLd она намеренно не указывается (см. ниже).

const faq = [
  {
    q: "Когда лучше ехать в Мурманск за северным сиянием?",
    a: "Сезон наблюдений длится с конца августа по апрель — в это время в Мурманске достаточно тёмное небо по ночам. Самые надёжные месяцы — с сентября по март, а пик активности обычно приходится на периоды около осеннего и весеннего равноденствия (сентябрь–октябрь и февраль–март).",
  },
  {
    q: "При каком Kp-индексе видно сияние прямо в городе?",
    a: "В самом Мурманске, несмотря на городскую засветку, сияние часто заметно уже при Kp 2–3. Чем выше индекс, тем ярче и южнее видна активность — но даже невысокий Kp даёт шанс, если небо чистое.",
  },
  {
    q: "Нужно ли уезжать далеко от города, чтобы увидеть сияние?",
    a: "Не обязательно, но желательно отъехать на 15–20 км от городской засветки — тогда сияние видно ярче и при более низкой активности. Популярные точки — посёлок Териберка на побережье и Хибины в районе Кировска и Апатитов.",
  },
  {
    q: "Сколько стоит долететь до Мурманска?",
    a: "Прямой рейс из Москвы занимает около 2 часов 10 минут, из Санкт-Петербурга — около 2 часов. Стоимость сильно зависит от сезона и даты покупки: от 2000 до 18 000 ₽ за билет в одну сторону.",
  },
];

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline:
    "Северное сияние в Мурманске 2026–2027: когда лучше ехать и где смотреть",
  description:
    "Сезон, лучшие месяцы, вероятность по Kp-индексу и проверенные точки для наблюдения северного сияния в Мурманске.",
  author: {
    "@type": "Person",
    name: "Надежда Горбатенко",
  },
  publisher: {
    "@type": "Organization",
    name: "Polarlights",
    url: "https://polarlights.pro",
  },
  dateModified: dateModifiedISO,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": pageUrl,
  },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<style define:vars={{ auroraBackMbImageUrl, auroraBackImageUrl }}>
  #description {
    background-image: var(--auroraBackMbImageUrl);
  }
  @media (min-width: 768px) {
    #description {
      background-image: var(--auroraBackImageUrl);
    }
  }

  img {
    max-width: 100%;
    height: 100%;
    border-radius: 20px;
  }

  h2 {
    margin-top: 40px;
    margin-bottom: 10px;
    font-size: 24px;
  }
  h3 {
    margin-top: 25px;
    margin-bottom: 8px;
    font-size: 19px;
  }
  p {
    text-align: justify;
  }
  a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  ul {
    display: block;
    text-align: left;
    list-style: disc;
    padding-left: 20px;
  }
  ol {
    display: block;
    text-align: left;
    list-style: decimal;
    padding-left: 20px;
  }
  h1 {
    font-size: 64px;
  }

  .description {
    align-items: center;
    text-align: center;
  }

  .description h2 {
    font-family: "SongerGrotesqueBold";
    font-size: 24px;
    margin: 60px 0 85px 0;
  }

  .updated-badge {
    display: inline-block;
    margin-top: 14px;
    padding: 4px 14px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.12);
    font-size: 15px;
    font-weight: normal;
    vertical-align: middle;
  }

  .author-line {
    max-width: 720px;
    margin: 20px auto 0;
    font-size: 15px;
    opacity: 0.85;
    text-align: left;
  }

  .lead-answer {
    max-width: 720px;
    margin: 20px auto 0;
    text-align: left;
  }

  .cta-block {
    margin: 20px 0 40px;
    padding: 20px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.06);
  }

  .images {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-behavior: smooth;
    margin: 10px 0 0 0;
    white-space: nowrap;
    justify-content: space-between;
    padding-bottom: 100px;
  }

  .image-slider-container {
    position: relative;
    margin: 0 auto;
    overflow: visible;
  }

  .imag {
    flex: 0 0 auto;
    width: 360px;
    position: relative;
    filter: drop-shadow(10px 10px 10px rgba(0, 0, 0, 0.8));
    border-radius: 20px;
  }

  .slider-button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    /* background: rgba(0, 0, 0, 0.5); /* Полупрозрачный фон */
    color: black;
    border: none;
    cursor: pointer;
    padding: 5px 15px;
    z-index: 1000;
    font-size: 30px;
  }

  .slider-button.left {
    left: -50px;
    color: white;
  }

  .slider-button.right {
    right: -50px;
    color: white;
  }

  @media (max-width: 510px) {
    .description h1 {
      font-size: 32px;
      line-height: 1.4;
      margin-bottom: 10px;
    }
  }

  @media (max-width: 1300px) {
    .images {
      overflow-x: auto;
    }
  }

  @media (max-width: 952px) {
    .slider-button {
      display: none !important;
    }
  }
  @media (max-width: 482px) {
    .imag {
      width: 90%;
    }
  }
</style>

<section
  class="description bg-contain bg-[center_50px] bg-no-repeat pt-[80px] pb-5 text-center md:bg-[0px_20px]"
  id="description"
>
  <h1>
    Северное сияние в Мурманске 2026–2027: когда лучше ехать и где смотреть
    <span class="updated-badge">Обновлено: {dateModifiedDisplay}</span>
  </h1>
  <p class="author-line">
    Автор: Надежда Горбатенко, разработчик Polarlights.pro — сервиса прогноза
    северного сияния. Выросла в Мурманской области и наблюдает сияние с детства.
  </p>
  <p class="lead-answer">
    Коротко: сезон наблюдений в Мурманске — с конца августа по апрель. Прямо в
    городе, несмотря на засветку, сияние часто заметно уже при Kp 2–3, а для
    ярких кадров лучше отъехать на несколько километров за город.
  </p>
</section>

<div class="pt-[25px] pb-[50px]">
  <h2>Почему именно Мурманск</h2>
  <p>
    Про Мурманскую область мы можем писать очень много. Это место, где я
    родилась и выросла — и увидела своё первое северное сияние ещё в детстве. Я
    отчётливо помню тот вечер: гуляла во дворе, и вдруг небо вспыхнуло
    переливающимися огнями. Я просто легла на сугроб и смотрела в небо, потеряв
    счёт времени — яркие полосы сливались в единую картину и всё время меняли
    цвета. Именно этот личный опыт наблюдений и лёг в основу сервиса
    Polarlights.
  </p>
  <p>
    Мурманск находится на широте 68.97°, 33.09° — это уже само по себе идеальное
    место для наблюдения северного сияния, и это самый крупный город в мире,
    расположенный за Полярным кругом.
  </p>

  <h2>Расположение и логистика</h2>
  <p>
    Мурманск — очень развитый город. Добраться можно и поездом, и самолётом,
    причём город находится не так далеко от Москвы, как многие думают: это самый
    удобный узел для пересадок из других регионов России.
  </p>
  <p>
    Самолётом можно добраться от Москвы примерно за 2 часа 10 минут, а от
    Санкт-Петербурга — примерно за 2 часа. Стоимость билета сильно зависит от
    сезона и даты покупки: некоторым счастливчикам удаётся купить билеты за 2000
    рублей, но в сезон цена обычно поднимается до 18 000 рублей.
  </p>
  <p>
    Прилетев в Мурманск, можно комфортно разместиться в гостиницах разного
    уровня комфорта и стоимости.
  </p>

  <h2>Где смотреть конкретно</h2>
  <p>
    Зачастую при высокой вероятности сияние видно прямо в городе — достаточно
    поднять голову вверх. Но чтобы увидеть его ярче и при более низкой
    активности, стоит отъехать на 15–20 км от городской засветки.
  </p>
  <ul>
    <li>
      <strong>Териберка</strong> — посёлок на побережье Баренцева моря, популярная
      точка у фотографов: открытый горизонт и минимум городской засветки.
    </li>
    <li>
      <strong>Хибины</strong> (район Кировска и Апатитов) — горная местность южнее
      Мурманска, ещё одно проверенное направление для охоты за сиянием.
    </li>
  </ul>
  <p>
    Следите за <a href="/#map">картой</a>, <a href="/#map">облачностью</a> и
    <a href="/#map">вероятностью</a> с помощью сервиса Polarlights — это поможет выбрать
    не только день, но и конкретное место.
  </p>

  <h2>А я точно увижу северное сияние?</h2>
  <p>
    Конечно, нет — мы не властны над природой. Например, из-за сильной
    облачности северное сияние можно не увидеть даже при высокой вероятности.
  </p>
  <p>
    Мы рекомендуем приезжать на несколько дней, чтобы в случае неудачи у вас был
    запасной день. Перед поездкой ориентируйтесь на индекс, но не забывайте, что
    он, как и погода, изменчив — сияние наблюдается не каждый день, и может быть
    так, что его не будет несколько суток.
  </p>
  <p>
    В долгосрочном планировании помогает <a href="/#index">индекс на 27 дней</a> (обновляется
    раз в неделю), а <a href="/#index">индекс на 3 дня</a> — более точный и обновляется
    дважды в сутки. Самыми точными для планирования остаются чистое небо и <a
      href="/#map">вероятность на ближайший час</a
    > — она рассчитывается под выбранную геолокацию.
  </p>

  <h2>Как проверить прогноз прямо сейчас</h2>
  <div class="cta-block">
    <p>
      Не гадайте — откройте <a href="/#map">карту и вероятность</a> на сегодня и ближайшие
      дни прямо на сайте, или поставьте
      <a href="/app">приложение Polarlights</a>, чтобы получать уведомления,
      когда шанс увидеть сияние в Мурманске особенно высок.
    </p>
  </div>

  <h2>Практические советы</h2>
  <ul>
    <li>
      Отъезжайте подальше от городских фонарей — 15–20 км уже заметно улучшают
      видимость.
    </li>
    <li>
      Одевайтесь теплее, чем кажется нужным: ожидание на морозе может затянуться
      на час и больше.
    </li>
    <li>
      Дайте глазам 10–15 минут привыкнуть к темноте — слабое сияние не всегда
      заметно сразу.
    </li>
    <li>
      Возьмите с собой телефон или камеру со штативом: длинная выдержка часто
      показывает сияние там, где глаз его почти не различает.
    </li>
    <li>
      Планируйте поездку на несколько дней — так шанс застать ясное небо выше.
    </li>
  </ul>

  <h2>Частые вопросы</h2>
  {
    faq.map((item) => (
      <>
        <h3>{item.q}</h3>
        <p>{item.a}</p>
      </>
    ))
  }

  <h2>Итог</h2>
  <p>
    Мурманск и область — очень удобное место для наблюдения северного сияния,
    как по своему расположению, так и по логистике. Ориентируйтесь на индекс и
    карту вероятности, будьте готовы уехать за город и дайте себе несколько дней
    в запасе — и шансы увидеть настоящее полярное сияние заметно вырастут.
  </p>

  <h2>Поларлайт поможет вам с планированием!</h2>

  <div class="mt-[60px] mb-[50px] text-left">
    <a
      class="font-[SongerGrotesqueBold] text-[24px] font-bold underline underline-offset-2"
      href="/blog">В блог о северном сиянии</a
    >
  </div>
  <div class="pb-[50px] text-left">
    <a
      class="font-[SongerGrotesqueBold] text-[24px] font-bold underline underline-offset-2"
      href="/">Перейти на главную страницу с картой и вероятностью</a
    >
  </div>

  <div class="image-slider-container">
    <button class="slider-button left" id="slideLeft">&#8249;</button>
    <div class="images" id="slider">
      <div class="imag">
        <Image src={mmsk1} alt="Северное сияние над Мурманском — вид с сопки" />
      </div>
      <div class="imag">
        <Image
          src={mmsk2}
          alt="Зелёное северное сияние над зимним Мурманском"
        />
      </div>
      <div class="imag">
        <Image
          src={mmsk3}
          alt="Северное сияние в Мурманской области над заснеженным пейзажем"
        />
      </div>
    </div>
    <button class="slider-button right" id="slideRight">&#8250;</button>
  </div>

  <script is:inline>
    {
      function initSlider() {
        const slider = document.getElementById("slider");
        const slideLeft = document.getElementById("slideLeft");
        const slideRight = document.getElementById("slideRight");

        if (!slider) return;

        const totalWidth = Array.from(slider.children).reduce(
          (sum, item) => sum + item.offsetWidth,
          0,
        );
        const visibleWidth = slider.offsetWidth;

        if (totalWidth > visibleWidth) {
          slideLeft.style.display = "block";
          slideRight.style.display = "block";

          slideLeft.addEventListener("click", () => {
            slider.scrollBy({ left: -380, behavior: "smooth" });
          });

          slideRight.addEventListener("click", () => {
            slider.scrollBy({ left: 380, behavior: "smooth" });
          });
        } else {
          slideLeft.style.display = "none";
          slideRight.style.display = "none";
        }
      }

      window.addEventListener("load", initSlider);
      window.addEventListener("resize", initSlider);
    }
  </script>
</div>

<script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
