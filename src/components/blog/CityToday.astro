---
import { getImage } from "astro:assets";
import auroraback_mb from "../../assets/auroraback_mb.png";
const auroraBackMbImageUrl = `url(${(await getImage({ src: auroraback_mb })).src})`;
import auroraback from "../../assets/auroraback.png";
const auroraBackImageUrl = `url(${(await getImage({ src: auroraback })).src})`;
import { CityAuroraNow } from "../reactive/CityAuroraNow";

export interface Props {
  pageUrl: string;
  title: string;
  metaDescription: string;
  updatedISO: string;
  updatedDisplay: string;
  lat: number;
  long: number;
  cityName: string;
  locationLabel: string;
  heroAnswer: string;
  breadcrumbCurrent: string;
  faq: { q: string; a: string }[];
  relatedLinks: { href: string; label: string }[];
  /** Язык страницы. По умолчанию "ru" — поведение не меняется для существующих страниц. */
  lang?: "ru" | "en" | "cn";
  /** Имя города на английском (именительный падеж) — для предвыбора города на карте с en-страниц */
  nameEn?: string;
  /** Имя города на китайском (именительный падеж) — для предвыбора города на карте с cn-страниц */
  nameCn?: string;
}

const {
  pageUrl,
  title,
  metaDescription,
  updatedISO,
  updatedDisplay,
  lat,
  long,
  cityName,
  locationLabel,
  heroAnswer,
  breadcrumbCurrent,
  faq,
  relatedLinks,
  lang = "ru",
  nameEn,
  nameCn,
} = Astro.props;

const CHROME = {
  ru: {
    breadcrumbsAria: "Хлебные крошки",
    home: "Главная",
    homeHref: "/",
    authorName: "Надежда Горбатенко",
    author:
      "Автор: Надежда Горбатенко, разработчик Polarlights.pro — сервиса прогноза северного сияния.",
    updatedPrefix: "Обновлено: ",
    faqHeading: "Частые вопросы",
    readAlso: "Читайте также",
    goHome: "Перейти на главную страницу с картой и вероятностью",
  },
  en: {
    breadcrumbsAria: "Breadcrumb",
    home: "Home",
    homeHref: "/en/",
    authorName: "Nadezhda Gorbatenko",
    author:
      "Author: Nadezhda Gorbatenko, developer of Polarlights.pro — an aurora forecast service.",
    updatedPrefix: "Updated: ",
    faqHeading: "Frequently Asked Questions",
    readAlso: "Read also",
    goHome: "Go to the homepage with the map and probability",
  },
  cn: {
    breadcrumbsAria: "面包屑导航",
    home: "首页",
    homeHref: "/cn/",
    authorName: "Nadezhda Gorbatenko",
    author:
      "作者：娜杰日达·戈尔巴特科，Polarlights.pro（北极光预报服务）开发者。",
    updatedPrefix: "更新时间：",
    faqHeading: "常见问题",
    readAlso: "延伸阅读",
    goHome: "前往首页查看地图和概率",
  },
} as const;

const c = CHROME[lang];

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: metaDescription,
  author: {
    "@type": "Person",
    name: c.authorName,
  },
  publisher: {
    "@type": "Organization",
    name: "Polarlights",
    url: "https://polarlights.pro",
  },
  dateModified: updatedISO,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": pageUrl,
  },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: c.home,
      item: `https://polarlights.pro${c.homeHref}`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: breadcrumbCurrent,
      item: pageUrl,
    },
  ],
};
---

<style define:vars={{ auroraBackMbImageUrl, auroraBackImageUrl }}>
  #city-today-description {
    background-image: var(--auroraBackMbImageUrl);
  }
  @media (min-width: 768px) {
    #city-today-description {
      background-image: var(--auroraBackImageUrl);
    }
  }

  /*
   * :global() — тело статьи (h2/h3/p/a/ul) приходит через <slot />
   * из страницы-родителя и не получает scope-атрибут этого компонента,
   * поэтому обычные скоуп-правила Astro их не матчат вообще (не вопрос
   * приоритета — правило просто не применяется). :global() снимает
   * скоупинг с внутренней части селектора, оставляя .city-today
   * обязательным условием.
   */
  .city-today :global(h2) {
    margin-top: 40px;
    margin-bottom: 10px;
    font-size: 34px !important;
  }
  .city-today :global(.faq-heading) {
    margin-top: 70px;
    margin-bottom: 10px;
    font-size: 34px !important;
  }
  .city-today :global(h3) {
    margin-top: 25px;
    margin-bottom: 8px;
    font-size: 19px;
    font-family: "SongerGrotesqueBold", sans-serif;
  }
  .city-today :global(p) {
    text-align: justify;
  }
  .city-today :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .city-today :global(ul) {
    display: block;
    text-align: left;
    list-style: disc;
    padding-left: 20px;
  }
  .city-today :global(h1) {
    font-size: 56px;
  }

  .description {
    align-items: center;
    text-align: center;
  }

  .description h2 {
    font-family: "SongerGrotesqueBold";
    font-size: 24px;
    margin: 60px 0 85px 0;
  }

  .updated-badge {
    display: block;
    width: fit-content;
    margin: 14px auto 0;
    padding: 4px 14px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.12);
    font-size: 15px;
    font-weight: normal;
  }

  .breadcrumbs {
    display: block;
    text-align: left;
    margin-bottom: 24px;
    font-size: 14px;
    opacity: 0.75;
  }

  .breadcrumbs a {
    opacity: 0.85;
  }

  .breadcrumbs-sep {
    margin: 0 6px;
    opacity: 0.5;
    text-decoration: none;
  }

  .breadcrumbs-current {
    opacity: 0.95;
  }

  .author-line {
    max-width: 720px;
    margin: 20px auto 0;
    font-size: 15px;
    opacity: 0.85;
    text-align: left;
  }

  .lead-answer {
    max-width: 720px;
    margin: 20px auto 0;
    text-align: left;
  }

  .cta-block {
    margin: 20px 0 40px;
    padding: 20px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 510px) {
    .city-today .description h1 {
      font-size: 32px;
      line-height: 1.4;
      margin-bottom: 10px;
    }
  }
</style>

<div class="city-today">
  <section
    class="description bg-contain bg-[center_50px] bg-no-repeat pt-[20px] pb-5 text-center md:bg-[0px_20px] md:pt-[40px]"
    id="city-today-description"
  >
    <nav class="breadcrumbs" aria-label={c.breadcrumbsAria}>
      <a href={c.homeHref}>{c.home}</a><span class="breadcrumbs-sep">/</span
      ><span class="breadcrumbs-current">{breadcrumbCurrent}</span>
    </nav>
    <h1>
      {title}
      <span class="updated-badge">{c.updatedPrefix}{updatedDisplay}</span>
    </h1>
    <p class="author-line">
      {c.author}
    </p>
    <p class="lead-answer">
      {heroAnswer}
    </p>
    <CityAuroraNow
      lat={lat}
      long={long}
      cityName={cityName}
      locationLabel={locationLabel}
      lang={lang}
      nameEn={nameEn}
      nameCn={nameCn}
      client:only="react"
    />
  </section>

  <div class="pt-[25px] pb-[50px]">
    <slot />

    <h2 class="faq-heading">{c.faqHeading}</h2>
    {
      faq.map((item) => (
        <>
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </>
      ))
    }

    <div class="mt-[60px] text-left">
      <h2>{c.readAlso}</h2>
      <ul>
        {
          relatedLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-[40px] mb-[50px] text-left">
      <a
        class="font-[SongerGrotesqueBold] text-[24px] font-bold underline underline-offset-2"
        href={c.homeHref}>{c.goHome}</a
      >
    </div>

    <slot name="gallery" />
  </div>
</div>

<script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
