---
import { getImage, Image } from "astro:assets";
import auroraback_mb from "../../assets/auroraback_mb.png";
const auroraBackMbImageUrl = `url(${(await getImage({ src: auroraback_mb })).src})`;
import auroraback from "../../assets/auroraback.png";
const auroraBackImageUrl = `url(${(await getImage({ src: auroraback })).src})`;
import moscow1 from "../../assets/moscow1.png";
import moscow2 from "../../assets/moscow2.png";
import moscow3 from "../../assets/moscow3.png";

const pageUrl = "https://polarlights.pro/blog/aurora-moscow/";
const dateModifiedISO = "2026-09-20";
const dateModifiedDisplay = "20.09.2026";
// datePublishedISO: точная дата первой публикации статьи неизвестна,
// поэтому в articleLd она намеренно не указывается (см. ниже).

const faq = [
  {
    q: "Бывает ли северное сияние в Москве?",
    a: "Да, но крайне редко — только во время сильнейших геомагнитных бурь.",
  },
  {
    q: "При каком Kp-индексе видно сияние в Москве?",
    a: "Нужен очень высокий Kp-индекс — не ниже 7–8. Это редкое явление, которое случается лишь при сильнейших вспышках на Солнце.",
  },
  {
    q: "Почему сияние почти не видно даже во время бури?",
    a: "Москва — огромный мегаполис с сильным световым загрязнением: городская подсветка буквально перекрывает слабое свечение в небе. Чтобы увидеть сияние, нужно выехать за город, в тёмное место без засветки, а лучше — на возвышенность с открытым горизонтом.",
  },
  {
    q: "Как узнать, что над Москвой ожидается сияние?",
    a: 'Следите за картой и прогнозом <a href="/" style="text-decoration: underline; text-underline-offset: 2px;">на сайте</a> и в <a href="/download/" style="text-decoration: underline; text-underline-offset: 2px;">приложении Polarlights</a> — включите уведомления, и вы получите сообщение, если сияние в вашем городе станет возможным.',
  },
];

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Северное сияние в Москве: бывает ли и как увидеть",
  description:
    "Можно ли увидеть северное сияние в Москве? Рассказываем, при каких условиях оно появляется, где лучше наблюдать и как следить за прогнозом в столице.",
  author: {
    "@type": "Person",
    name: "Надежда Горбатенко",
  },
  publisher: {
    "@type": "Organization",
    name: "Polarlights",
    url: "https://polarlights.pro",
  },
  dateModified: dateModifiedISO,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": pageUrl,
  },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a.replace(/<[^>]+>/g, ""),
    },
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Главная",
      item: "https://polarlights.pro/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Блог о северном сиянии",
      item: "https://polarlights.pro/blog/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Северное сияние в Москве: бывает ли и как увидеть",
      item: pageUrl,
    },
  ],
};
---

<style define:vars={{ auroraBackMbImageUrl, auroraBackImageUrl }}>
  #description {
    background-image: var(--auroraBackMbImageUrl);
  }
  @media (min-width: 768px) {
    #description {
      background-image: var(--auroraBackImageUrl);
    }
  }

  img {
    max-width: 100%;
    height: auto;
    border-radius: 20px;
  }

  h2 {
    margin-top: 40px;
    margin-bottom: 10px;
    font-size: 24px;
  }
  h3 {
    margin-top: 25px;
    margin-bottom: 8px;
    font-size: 19px;
  }
  p {
    text-align: justify;
  }
  a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  ul {
    display: block;
    text-align: left;
    list-style: disc;
    padding-left: 20px;
  }
  ol {
    display: block;
    text-align: left;
    list-style: decimal;
    padding-left: 20px;
  }
  h1 {
    font-size: 64px;
  }

  .description {
    align-items: center;
    text-align: center;
  }

  .description h2 {
    font-family: "SongerGrotesqueBold";
    font-size: 24px;
    margin: 60px 0 85px 0;
  }

  .updated-badge {
    display: block;
    width: fit-content;
    margin: 14px auto 0;
    padding: 4px 14px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.12);
    font-size: 15px;
    font-weight: normal;
  }

  .breadcrumbs {
    display: block;
    text-align: left;
    margin-bottom: 24px;
    font-size: 14px;
    opacity: 0.75;
  }

  .breadcrumbs a {
    opacity: 0.85;
  }

  .breadcrumbs-sep {
    margin: 0 6px;
    opacity: 0.5;
    text-decoration: none;
  }

  .breadcrumbs-current {
    opacity: 0.95;
  }

  .author-line {
    max-width: 720px;
    margin: 20px auto 0;
    font-size: 15px;
    opacity: 0.85;
    text-align: left;
  }

  .lead-answer {
    max-width: 720px;
    margin: 20px auto 0;
    text-align: left;
  }

  .cta-block {
    margin: 20px 0 40px;
    padding: 20px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.06);
  }

  .images {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-behavior: smooth;
    margin: 10px 0 0 0;
    white-space: nowrap;
    justify-content: space-between;
    padding-bottom: 100px;
  }

  .image-slider-container {
    position: relative;
    margin: 0 auto;
    overflow: visible;
  }

  .imag {
    flex: 0 0 auto;
    width: 360px;
    position: relative;
    filter: drop-shadow(10px 10px 10px rgba(0, 0, 0, 0.8));
    border-radius: 20px;
  }

  .slider-button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    /* background: rgba(0, 0, 0, 0.5); /* Полупрозрачный фон */
    color: black;
    border: none;
    cursor: pointer;
    padding: 5px 15px;
    z-index: 1000;
    font-size: 30px;
  }

  .slider-button.left {
    left: -50px;
    color: white;
  }

  .slider-button.right {
    right: -50px;
    color: white;
  }

  @media (max-width: 510px) {
    .description h1 {
      font-size: 32px;
      line-height: 1.4;
      margin-bottom: 10px;
    }
  }

  @media (max-width: 1300px) {
    .images {
      overflow-x: auto;
    }
  }

  @media (max-width: 952px) {
    .slider-button {
      display: none !important;
    }
  }
  @media (max-width: 482px) {
    .imag {
      width: 90%;
    }
  }
</style>

<section
  class="description bg-contain bg-[center_50px] bg-no-repeat pt-[20px] pb-5 text-center md:bg-[0px_20px] md:pt-[40px]"
  id="description"
>
  <nav class="breadcrumbs" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span class="breadcrumbs-sep">/</span><a href="/blog"
      >Блог о северном сиянии</a
    ><span class="breadcrumbs-sep">/</span><span class="breadcrumbs-current"
      >Северное сияние в Москве: бывает ли и как увидеть</span
    >
  </nav>
  <h1>
    Северное сияние в Москве: бывает ли и как увидеть
    <span class="updated-badge">Обновлено: {dateModifiedDisplay}</span>
  </h1>
  <p class="author-line">
    Автор: Надежда Горбатенко, разработчик Polarlights.pro — сервиса прогноза
    северного сияния. Выросла в Мурманской области и наблюдает сияние с детства.
  </p>
  <p class="lead-answer">
    Коротко: северное сияние в Москве — очень редкое явление. Оно появляется
    только во время сильнейших геомагнитных бурь, когда Kp-индекс поднимается
    выше 7 — тогда сияние видно не только за Полярным кругом, но и значительно
    южнее.
  </p>
</section>

<div class="pt-[25px] pb-[50px]">
  <h2>Бывает ли северное сияние в Москве?</h2>
  <p>
    Да, северное сияние в Москве бывает, но крайне редко. Чтобы оно появилось
    над столицей, должна произойти сильнейшая геомагнитная буря. В такие моменты
    сияние становится видно не только за Полярным кругом, но и значительно южнее
    — например, в Санкт-Петербурге, Твери и даже в Подмосковье. Последние
    заметные вспышки приходились на периоды высокой солнечной активности.
    Например, весной 2024 года сияние удалось не только сфотографировать в
    Ленинградской, Ярославской и даже Московской областях, но и отчётливо
    увидеть над городом.
  </p>

  <h2>Почему сияние почти не видно в Москве?</h2>
  <ol>
    <li>
      География. Москва находится слишком далеко от Полярного круга. Для
      наблюдений нужен KP-индекс 7–8, а это редкое явление.
    </li>
    <li>
      Световое загрязнение. Огромный мегаполис буквально «подсвечивает» небо.
      Даже если сияние есть, рассмотреть его в центре столицы невозможно и надо
      выезжать далеко за город.
    </li>
  </ol>

  <h2>Где реально увидеть северное сияние в Москве и области</h2>
  <p>
    Если случится сильная геомагнитная буря, шансы заметить сияние выше всего:
  </p>
  <ul>
    <li>за городом, в тёмных местах без подсветки;</li>
    <li>
      на возвышенностях, где горизонт максимально открыт и видно больше неба.
    </li>
  </ul>

  <h2>Как следить за прогнозом</h2>
  <div class="cta-block">
    <p>
      На сайте и в приложении <a href="/download/">Polarlights</a> доступна <a
        href="/#map">карта сияния</a
      > и прогноз по всем регионам России. В приложении вы можете включить уведомления
      и получить сообщение, если северное сияние в выбранном городе станет возможным.
    </p>
  </div>

  <h2>Частые вопросы</h2>
  {
    faq.map((item) => (
      <>
        <h3>{item.q}</h3>
        <p set:html={item.a} />
      </>
    ))
  }

  <h2>Итоги</h2>
  <p>
    Северное сияние в Москве — редкая удача, связанная с сильнейшими вспышками
    на Солнце. Чаще всего за Авророй всё же отправляются на север. Но даже
    жителям столицы стоит следить за прогнозами — вдруг именно сегодня небо над
    Москвой засияет разноцветными сполохами Авроры.
  </p>

  <h2>Polarlights поможет не пропустить сияние в Москве!</h2>

  <div class="mt-[60px] mb-[50px] text-left">
    <a
      class="font-[SongerGrotesqueBold] text-[24px] font-bold underline underline-offset-2"
      href="/blog">В блог о северном сиянии</a
    >
  </div>
  <div class="pb-[50px] text-left">
    <a
      class="font-[SongerGrotesqueBold] text-[24px] font-bold underline underline-offset-2"
      href="/">Перейти на главную страницу с картой и вероятностью</a
    >
  </div>

  <div class="image-slider-container">
    <button class="slider-button left" id="slideLeft">&#8249;</button>
    <div class="images" id="slider">
      <div class="imag">
        <Image
          src={moscow1}
          alt="Наблюдатель фотографирует северное сияние среди заснеженных деревьев"
        />
      </div>
      <div class="imag">
        <Image
          src={moscow2}
          alt="Зелёное северное сияние над заснеженной равниной"
        />
      </div>
      <div class="imag">
        <Image
          src={moscow3}
          alt="Разноцветное северное сияние над зимним хвойным лесом"
        />
      </div>
    </div>
    <button class="slider-button right" id="slideRight">&#8250;</button>
  </div>

  <script is:inline>
    {
      function initSlider() {
        const slider = document.getElementById("slider");
        const slideLeft = document.getElementById("slideLeft");
        const slideRight = document.getElementById("slideRight");

        if (!slider) return;

        const totalWidth = Array.from(slider.children).reduce(
          (sum, item) => sum + item.offsetWidth,
          0,
        );
        const visibleWidth = slider.offsetWidth;

        if (totalWidth > visibleWidth) {
          slideLeft.style.display = "block";
          slideRight.style.display = "block";

          slideLeft.addEventListener("click", () => {
            slider.scrollBy({ left: -380, behavior: "smooth" });
          });

          slideRight.addEventListener("click", () => {
            slider.scrollBy({ left: 380, behavior: "smooth" });
          });
        } else {
          slideLeft.style.display = "none";
          slideRight.style.display = "none";
        }
      }

      window.addEventListener("load", initSlider);
      window.addEventListener("resize", initSlider);
    }
  </script>
</div>

<script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
