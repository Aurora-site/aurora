---
import { getImage, Image } from "astro:assets";
import auroraback_mb from "../../assets/auroraback_mb.png";
const auroraBackMbImageUrl = `url(${(await getImage({ src: auroraback_mb })).src})`;
import auroraback from "../../assets/auroraback.png";
const auroraBackImageUrl = `url(${(await getImage({ src: auroraback })).src})`;
import kp1 from "../../assets/blog_kp_1.png";
import kp2 from "../../assets/blog_kp_2.png";
import kp3 from "../../assets/blog_kp_3.png";

const pageUrl = "https://polarlights.pro/blog/kp-index/";
const dateModifiedISO = "2026-09-21";
const dateModifiedDisplay = "21.09.2026";
// datePublishedISO: точная дата первой публикации статьи неизвестна,
// поэтому в articleLd она намеренно не указывается (см. ниже).

const faq = [
  {
    q: "Что такое KP-индекс простыми словами?",
    a: "KP-индекс — это показатель, который отражает уровень геомагнитной активности Земли. Когда на Солнце происходят вспышки и выбросы плазмы, поток частиц достигает Земли и «раскачивает» магнитное поле — в такие моменты и появляются условия для северного сияния. Измеряется по шкале от 0 до 9: 1–3 — спокойная обстановка, 4–5 — сильная активность, 6–7 — сильная геомагнитная буря, 8–9 — экстремальная буря.",
  },
  {
    q: "Какой KP-индекс нужен, чтобы увидеть северное сияние?",
    a: "Зависит от того, где вы находитесь. При KP 1–3 сияние видно только в полярных широтах — Мурманск, Норильск, Рейкьявик. При KP 4–5 — уже южнее: Санкт-Петербург, Стокгольм, север США. При KP 6–7 может достигать Москвы и Берлина. При KP 8–9 сияние видно очень далеко на юге — вплоть до Парижа и Белгорода.",
  },
  {
    q: "Высокий KP-индекс — значит сияние гарантировано?",
    a: "Нет. KP — общий показатель геомагнитной активности, одинаковый для всего земного шара, а вот видимость сияния для конкретного места зависит от локальных условий. Поэтому вероятность нужно смотреть отдельно для своей геолокации, а не полагаться только на KP.",
  },
  {
    q: "Почему при высоком KP сияние иногда не видно?",
    a: "Самые частые причины: облачность (даже сильное сияние не пробьёт плотные тучи), засветка от города (фонари мешают увидеть слабое свечение), слишком светлое небо, например в полярный день, а также то, что сияние появляется волнами — может ярко посветить 5–10 минут и затихнуть, а может светить часами.",
  },
  {
    q: "Почему прогноз KP-индекса всё время меняется?",
    a: "Это нормально — прогноз может меняться несколько раз за вечер, потому что данные космической погоды обновляются постоянно, солнечный ветер ускоряется или ослабевает, а направление потока частиц меняется. Поэтому лучше ориентироваться на вероятность для своей геолокации, а не только на сам индекс.",
  },
];

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "KP-индекс: что это такое и какой нужен для северного сияния",
  description:
    "Что такое KP-индекс простыми словами, какой уровень нужен для северного сияния в вашем городе и почему высокий KP не гарантирует, что сияние будет видно.",
  author: {
    "@type": "Person",
    name: "Надежда Горбатенко",
  },
  publisher: {
    "@type": "Organization",
    name: "Polarlights",
    url: "https://polarlights.pro",
  },
  dateModified: dateModifiedISO,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": pageUrl,
  },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a.replace(/<[^>]+>/g, ""),
    },
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Главная",
      item: "https://polarlights.pro/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Блог о северном сиянии",
      item: "https://polarlights.pro/blog/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "KP-индекс: что это такое",
      item: pageUrl,
    },
  ],
};
