---
import { Image, getImage } from "astro:assets";
import ruStore from "/src/assets/ruStore.png";
import store from "/src/assets/AppStore.png";
import { useAstroTranslations } from "../../i18n/utils";
import auroraback_mb from "../../assets/auroraback_mb.png";
const auroraBackImageUrl = `url(${(await getImage({ src: auroraback_mb })).src})`;
import auroraback_app from "../../assets/auroraback_app.png";
const auroraBackAppImageUrl = `url(${(await getImage({ src: auroraback_app })).src})`;
import mapVideo from "../../assets/blog_map_video.mp4";
import mapVideoPoster from "../../assets/blog_map_video_poster.jpg";
const t = useAstroTranslations(Astro);

const pageUrl = "https://polarlights.pro/app/";

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t("breadcrumbs.home"),
      item: "https://polarlights.pro/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t("H.app"),
      item: pageUrl,
    },
  ],
};
---

<style define:vars={{ auroraBackImageUrl, auroraBackAppImageUrl }}>
  .description h1 {
    font-family: "SongerGrotesqueBold";
    font-size: 64px;
  }

  .breadcrumbs {
    display: block;
    text-align: left;
    margin-bottom: 24px;
    font-size: 14px;
    opacity: 0.75;
  }

  .breadcrumbs a {
    opacity: 0.85;
  }

  .breadcrumbs-sep {
    margin: 0 6px;
    opacity: 0.5;
    text-decoration: none;
  }

  .breadcrumbs-current {
    opacity: 0.95;
  }

  .app {
    font-family: "SongerGrotesqueBold";
    font-size: 64px;
  }

  .description h2 {
    font-family: "SongerGrotesqueBold";
    font-size: 36px;
    /* margin: 60px 0; */
  }

  /*  .description p {
      margin: 0 auto;
      font-size: 1em;
      line-height: 1.5;
      text-align: left;
    }*/

  .description ul {
    display: block;
    padding-top: 60px;
    font-size: 36px;
    text-align: left;
    list-style: disc; /* Добавляем маркеры */
    padding-left: 20px; /* Отступ для корректного отображения */
  }

  .description ul li {
    font-family: "SongerGrotesqueBold";
    font-size: 24px;
  }

  p {
    font-size: 16px;
    text-align: left;
  }

  .store-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    padding: 10px 0 10px;
  }

  .store-badge {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 12px 26px;
    border-radius: 16px;
    background: #386e784d;
    border: 1px solid #ffffff1f;
    text-decoration: none;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .store-badge:hover {
    background: #386e7880;
    transform: translateY(-2px);
  }

  .store-badge-icon {
    width: 34px;
    height: 34px;
    object-fit: contain;
    flex: 0 0 auto;
  }

  .store-badge-text {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.25;
  }

  .store-badge-eyebrow {
    font-size: 12px;
    opacity: 0.75;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  .store-badge-name {
    font-family: "SongerGrotesqueBold";
    font-size: 20px;
    color: white;
  }

  #description {
    background-image: var(--auroraBackImageUrl);
  }
  @media (min-width: 768px) {
    #description {
      background-image: var(--auroraBackAppImageUrl);
    }
  }

  @media (max-width: 640px) {
    .description ul li {
      font-size: 20px;
    }
    .description h2 {
      font-size: 20px;
    }
  }

  @media (max-width: 510px) {
    .description h1 {
      line-height: 74px;
    }

    .app {
      margin-top: 40px;
    }
  }

  @media (max-width: 440px) {
    .app {
      font-size: 40px;
    }
  }

  @media (max-width: 380px) {
    .store-badge {
      width: 100%;
      justify-content: center;
    }
  }

  .video-block {
    position: fixed;
    left: 20px;
    bottom: 20px;
    width: 130px;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    filter: drop-shadow(8px 8px 12px rgba(0, 0, 0, 0.7));
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease,
      width 0.3s ease,
      filter 0.3s ease;
    z-index: 200;
  }

  .video-block.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .video-block.expanded {
    width: 240px;
    filter: drop-shadow(12px 12px 20px rgba(0, 0, 0, 0.85));
  }

  .map-video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
  }

  .video-close {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
  }

  @media (max-width: 480px) {
    .video-block {
      left: 12px;
      bottom: 12px;
      width: 110px;
    }

    .video-block.expanded {
      width: 180px;
    }
  }
</style>

<section
  class="description bg-contain bg-[center_50px] bg-no-repeat pt-[20px] pb-5 text-center md:bg-[0px_20px] md:pt-[40px]"
  id="description"
>
  <nav class="breadcrumbs" aria-label={t("breadcrumbs.ariaLabel")}>
    <a href="/">{t("breadcrumbs.home")}</a><span class="breadcrumbs-sep">/</span
    ><span class="breadcrumbs-current">{t("H.app")}</span>
  </nav>
  <h1>{t("App.title")}</h1>
  <div class="app">{t("App.app")}</div>
  <p class="pt-16 text-left">
    {t("App.text1")}
  </p>
  <ul>
    <li>{t("App.point1")}</li>
    <li>{t("App.point2")}</li>
    <li>{t("App.point3")}</li>
    <li>{t("App.point4")}</li>
    <li>{t("App.point5")}</li>
  </ul>
  <h2 class="pt-[60px] pb-[60px] text-left text-[36px]">
    {t("App.mini-title1")}
  </h2>

  <div class="store-badges">
    <a
      class="store-badge"
      href="https://www.rustore.ru/catalog/app/com.polarlights"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Image class="store-badge-icon" src={ruStore} alt="RuStore" />
      <span class="store-badge-text">
        <span class="store-badge-eyebrow">{t("app.download")}</span>
        <span class="store-badge-name">RuStore</span>
      </span>
    </a>

    <a
      class="store-badge"
      href="https://apps.apple.com/ru/app/северное-сияние-карта-прогноз/id6744652523"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Image class="store-badge-icon" src={store} alt="App Store" />
      <span class="store-badge-text">
        <span class="store-badge-eyebrow">{t("app.download")}</span>
        <span class="store-badge-name">App Store</span>
      </span>
    </a>
  </div>

  <div class="video-block" id="mapVideoBlock">
    <video
      id="mapVideo"
      class="map-video"
      src={mapVideo}
      poster={mapVideoPoster.src}
      muted
      loop
      playsinline
      preload="metadata"></video>
    <button
      type="button"
      class="video-close"
      id="mapVideoClose"
      aria-label="Закрыть видео">×</button
    >
  </div>
</section>

<script is:inline>
  {
    function initMapVideo() {
      const block = document.getElementById("mapVideoBlock");
      const video = document.getElementById("mapVideo");
      const closeBtn = document.getElementById("mapVideoClose");

      if (!block || !video || !closeBtn) return;

      block.classList.add("visible");
      video.play().catch(() => {});

      video.addEventListener("click", () => {
        if (!block.classList.contains("expanded")) {
          block.classList.add("expanded");
          video.muted = false;
          video.play().catch(() => {});
        }
      });

      closeBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        block.classList.remove("visible", "expanded");
        video.pause();
        video.muted = true;
      });
    }

    window.addEventListener("load", initMapVideo);
  }
</script>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
