---
import { useAstroTranslations } from "../../i18n/utils";
const t = useAstroTranslations(Astro);
import { Image } from "astro:assets";
import mapShot from "../../assets/blog_map_1.png";
import notifyShot from "../../assets/aurora_photo_1.png";
import kpShot from "../../assets/blog_kp_1.png";
---

<style>
  .description h1 {
    font-family: "SongerGrotesqueBold";
    font-size: 64px;
  }

  .description h2 {
    font-family: "SongerGrotesqueBold";
    font-size: 36px;
  }

  .description ul {
    display: block;
    padding-top: 60px;
    font-size: 24px;
    text-align: left;
    list-style: disc;
    padding-left: 20px;
  }

  .description ul li {
    font-family: "SongerGrotesqueBold";
    font-size: 20px;
  }

  .feature-bento {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    grid-template-rows: repeat(2, 220px);
    gap: 20px;
  }

  .feature-tile {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    isolation: isolate;
  }

  .feature-tile--map {
    grid-row: span 2;
  }

  .feature-tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: -2;
  }

  .feature-tile:hover img {
    transform: scale(1.05);
  }

  .feature-tile::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(4, 16, 18, 0.92) 0%,
      rgba(4, 16, 18, 0.5) 42%,
      rgba(4, 16, 18, 0.05) 72%
    );
  }

  .feature-tile {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 22px;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s ease;
  }

  .feature-tile:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(0, 60, 50, 0.4);
  }

  @keyframes featureTileIn {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .feature-bento[data-revealed="true"] .feature-tile {
    animation: featureTileIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .feature-bento[data-revealed="true"] .feature-tile:nth-child(1) {
    animation-delay: 0s;
  }
  .feature-bento[data-revealed="true"] .feature-tile:nth-child(2) {
    animation-delay: 0.1s;
  }
  .feature-bento[data-revealed="true"] .feature-tile:nth-child(3) {
    animation-delay: 0.2s;
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(6px);
    margin-bottom: 14px;
  }

  .feature-icon svg {
    width: 20px;
    height: 20px;
    stroke: white;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .feature-title {
    font-family: "SongerGrotesqueBold";
    font-size: 22px;
    color: white;
    margin-bottom: 8px;
    text-align: left;
  }

  .feature-tile--map .feature-title {
    font-size: 26px;
  }

  .feature-text {
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.88);
    text-align: left;
    max-width: 38ch;
  }

  .feature-bento[data-revealed="false"] .feature-tile {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-bento[data-revealed="false"] .feature-tile {
      opacity: 1;
    }
    .feature-bento[data-revealed="true"] .feature-tile {
      animation: none;
    }
    .feature-tile,
    .feature-tile img {
      transition: none;
    }
  }

  @media (max-width: 768px) {
    .feature-bento {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .feature-tile {
      grid-row: auto;
      min-height: 260px;
    }

    .feature-tile--map {
      min-height: 320px;
    }
  }

  @media (max-width: 640px) {
    .description h2 {
      font-size: 20px;
    }
  }
</style>

<section class="description pt-[0px] pb-5 text-center" id="description">
  <div class="feature-bento" id="featureBento" data-revealed="false">
    <div class="feature-tile feature-tile--map">
      <Image
        src={mapShot}
        alt="Карта северного сияния в реальном времени в приложении"
      />
      <div class="feature-icon">
        <svg viewBox="0 0 24 24">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
      </div>
      <p class="feature-title">{t("App.feature2-title")}</p>
      <p class="feature-text">{t("App.feature2-text")}</p>
    </div>

    <div class="feature-tile">
      <Image src={notifyShot} alt="Человек наблюдает северное сияние" />
      <div class="feature-icon">
        <svg viewBox="0 0 24 24">
          <path d="M6 8a6 6 0 0 1 12 0c0 4.5 1.5 6.5 2 7H4c.5-.5 2-2.5 2-7Z"
          ></path>
          <path d="M10 19a2 2 0 0 0 4 0"></path>
        </svg>
      </div>
      <p class="feature-title">{t("App.feature1-title")}</p>
      <p class="feature-text">{t("App.feature1-text")}</p>
    </div>

    <div class="feature-tile">
      <Image src={kpShot} alt="Северное сияние над лесом" />
      <div class="feature-icon">
        <svg viewBox="0 0 24 24">
          <path d="M3.5 19a8.5 8.5 0 1 1 17 0"></path>
          <path d="m12 13 3.5-3.5"></path>
          <circle cx="12" cy="13" r="1"></circle>
        </svg>
      </div>
      <p class="feature-title">{t("App.feature3-title")}</p>
      <p class="feature-text">{t("App.feature3-text")}</p>
    </div>
  </div>

  <div class="pt-[60px] text-left">
    <h2>{t("App.mini-title2")}</h2>
  </div>
  <p class="pt-[40px] pb-[70px] text-left">
    {t("App.text-final")}
  </p>
</section>

<script is:inline>
  {
    function initFeatureReveal() {
      const bento = document.getElementById("featureBento");
      if (!bento) return;

      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (prefersReduced || !("IntersectionObserver" in window)) {
        bento.dataset.revealed = "true";
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              bento.dataset.revealed = "true";
              observer.disconnect();
            }
          });
        },
        { threshold: 0.2 },
      );

      observer.observe(bento);
    }

    window.addEventListener("DOMContentLoaded", initFeatureReveal);
  }
</script>
