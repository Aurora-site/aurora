---
import { useAstroTranslations } from "../../i18n/utils";
const t = useAstroTranslations(Astro);
---

<style>
  .description h1 {
    font-family: "SongerGrotesqueBold";
    font-size: 64px;
  }

  .description h2 {
    font-family: "SongerGrotesqueBold";
    font-size: 36px;
  }

  .description ul {
    display: block;
    padding-top: 60px;
    font-size: 24px;
    text-align: left;
    list-style: disc; /* Добавляем маркеры */
    padding-left: 20px; /* Отступ для корректного отображения */
  }

  .description ul li {
    font-family: "SongerGrotesqueBold";
    font-size: 20px;
  }

  .feature-cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    padding-top: 24px;
  }

  .feature-card {
    flex: 1 1 280px;
    max-width: 340px;
    background-color: #386e784d;
    border: 1px solid #ffffff1f;
    border-radius: 20px;
    padding: 30px 26px;
    text-align: left;
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, #18a5bf, #006909);
    margin-bottom: 20px;
  }

  .feature-icon svg {
    width: 28px;
    height: 28px;
    stroke: white;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .feature-title {
    font-family: "SongerGrotesqueBold";
    font-size: 22px;
    color: white;
    margin-bottom: 10px;
  }

  .feature-text {
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.9;
  }

  @media (max-width: 640px) {
    .description h2 {
      font-size: 20px;
    }

    .feature-card {
      flex: 1 1 100%;
      max-width: 100%;
    }
  }
</style>

<section class="description pt-[0px] pb-5 text-center" id="description">
  <div class="feature-cards">
    <div class="feature-card">
      <div class="feature-icon">
        <svg viewBox="0 0 24 24">
          <path d="M6 8a6 6 0 0 1 12 0c0 4.5 1.5 6.5 2 7H4c.5-.5 2-2.5 2-7Z"
          ></path>
          <path d="M10 19a2 2 0 0 0 4 0"></path>
        </svg>
      </div>
      <p class="feature-title">{t("App.feature1-title")}</p>
      <p class="feature-text">{t("App.feature1-text")}</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">
        <svg viewBox="0 0 24 24">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
      </div>
      <p class="feature-title">{t("App.feature2-title")}</p>
      <p class="feature-text">{t("App.feature2-text")}</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">
        <svg viewBox="0 0 24 24">
          <path d="M3.5 19a8.5 8.5 0 1 1 17 0"></path>
          <path d="m12 13 3.5-3.5"></path>
          <circle cx="12" cy="13" r="1"></circle>
        </svg>
      </div>
      <p class="feature-title">{t("App.feature3-title")}</p>
      <p class="feature-text">{t("App.feature3-text")}</p>
    </div>
  </div>
  <div class="pt-[60px] text-left">
    <h2>{t("App.mini-title2")}</h2>
  </div>
  <p class="pt-[40px] pb-[70px] text-left">
    {t("App.text-final")}
  </p>
</section>
