---
import { useAstroTranslations } from "../i18n/utils";
const t = useAstroTranslations(Astro);
---

<style>
  #description {
    position: relative;
    isolation: isolate;
  }

  .description-video-mask {
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    max-width: 100vw;
    height: 100%;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: -2;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 55%,
      transparent 98%
    );
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 55%,
      transparent 98%
    );
  }

  .description-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: brightness(0.75) saturate(0.8);
    pointer-events: none;
  }

  .description-fade-top {
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    max-width: 100vw;
    height: 170px;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgba(0, 27, 36, 1) 0%,
      rgba(0, 27, 36, 0.85) 25%,
      rgba(0, 27, 36, 0.5) 55%,
      rgba(0, 27, 36, 0.18) 80%,
      rgba(0, 27, 36, 0) 100%
    );
  }

  .description > *:not(.description-video-mask):not(.description-fade-top) {
    position: relative;
    z-index: 1;
  }

  .description h1 {
    font-family: "SongerGrotesqueBold";
    font-size: 64px;
  }

  .description h2 {
    font-family: "SongerGrotesqueBold";
    font-size: 24px;
    margin: 60px 0 85px 0;
  }

  .description p {
    margin: 0 auto;
    font-size: 16px;
    /* line-height: 1.5; */
    text-align: left;
  }

  @media (max-width: 510px) {
    .description h1 {
      line-height: 74px;
    }

    .description h2 {
      margin: 50px 0 55px 0;
    }
  }

  @media (max-width: 640px) {
    .description-video-mask {
      top: 108px;
      /* Fixed px height, not a percentage. A percentage height on an
         absolutely positioned element whose containing block (#description)
         has no explicit height of its own (it is sized by its text content)
         is a well-known cross-browser ambiguity: different engines can
         resolve it against different boxes. That mismatch would shift
         where this mask's gradient physically lands on a real device
         versus in this sandbox's Chromium, which matches the symptom
         (a lighter band appearing roughly where the fade should be).
         A fixed height removes that ambiguity entirely. 300px matches
         what 50% was previously resolving to at the tested widths, so
         the glow's on-screen position is unchanged. */
      height: 300px;
      -webkit-mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        black 18%,
        black 55%,
        transparent 98%
      );
      mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        black 18%,
        black 55%,
        transparent 98%
      );
    }

    .description-video {
      object-position: center 40%;
    }

    .description-fade-top {
      /* Slightly taller than the desktop default: the video now starts
         108px lower, so the opaque header-colored overlay needs a bit
         more reach to keep comfortably overlapping the video's own
         fade-in zone. */
      height: 200px;
    }
  }
</style>

<section class="description pt-[80px] pb-5 text-center" id="description">
  <div class="description-video-mask">
    <video
      class="description-video"
      autoplay
      loop
      muted
      playsinline
      poster="/videos/aurora-hero-loop-poster.webp"
    >
      <source src="/videos/aurora-hero-loop.webm" type="video/webm" />
      <source src="/videos/aurora-hero-loop.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="description-fade-top"></div>
  <h1>{t("description.title")}</h1>
  <h2>{t("description.how")}</h2>
  <p>{t("description.text1")}</p>
  <p>
    {t("description.text2")}
  </p>
</section>
