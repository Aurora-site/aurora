---
import { useAstroTranslations } from "../i18n/utils";
const t = useAstroTranslations(Astro);
---

<style>
  .description-video-wrap {
    width: 100%;
    max-width: 640px;
    aspect-ratio: 16 / 9;
    margin: 50px auto 0;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
  }

  .description-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .description-video-wrap {
      max-width: 820px;
      margin-top: 20px;
    }
  }

  .description h1 {
    font-family: "SongerGrotesqueBold";
    font-size: 64px;
  }

  .description h2 {
    font-family: "SongerGrotesqueBold";
    font-size: 24px;
    margin: 60px 0 85px 0;
  }

  .description p {
    margin: 0 auto;
    font-size: 16px;
    /* line-height: 1.5; */
    text-align: left;
  }

  @media (max-width: 510px) {
    .description h1 {
      line-height: 74px;
    }

    .description h2 {
      margin: 50px 0 55px 0;
    }
  }
</style>

<section class="description pt-[80px] pb-5 text-center" id="description">
  <h1>{t("description.title")}</h1>
  <div class="description-video-wrap">
    <video
      class="description-video"
      autoplay
      loop
      muted
      playsinline
      poster="/videos/aurora-hero-loop-poster.webp"
    >
      <source src="/videos/aurora-hero-loop.webm" type="video/webm" />
      <source src="/videos/aurora-hero-loop.mp4" type="video/mp4" />
    </video>
  </div>
  <h2>{t("description.how")}</h2>
  <p>{t("description.text1")}</p>
  <p>
    {t("description.text2")}
  </p>
</section>
