---
import { useAstroTranslations } from "../i18n/utils";
const t = useAstroTranslations(Astro);
---

<style>
  #description {
    position: relative;
    background-color: #00101d;
  }

  .description-video {
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    max-width: 100vw;
    height: 100%;
    transform: translateX(-50%);
    object-fit: cover;
    object-position: center 35%;
    pointer-events: none;
    z-index: 0;
  }

  .description > *:not(.description-video) {
    position: relative;
    z-index: 1;
  }

  .description h1 {
    font-family: "SongerGrotesqueBold";
    font-size: 64px;
  }

  .description h2 {
    font-family: "SongerGrotesqueBold";
    font-size: 24px;
    margin: 60px 0 85px 0;
  }

  .description p {
    margin: 0 auto;
    font-size: 16px;
    /* line-height: 1.5; */
    text-align: left;
  }

  @media (max-width: 510px) {
    .description h1 {
      line-height: 74px;
    }

    .description h2 {
      margin: 50px 0 55px 0;
    }
  }
</style>

<section class="description pt-[80px] pb-5 text-center" id="description">
  <video
    class="description-video"
    autoplay
    loop
    muted
    playsinline
    poster="/videos/aurora-hero-loop-poster.webp"
  >
    <source src="/videos/aurora-hero-loop.webm" type="video/webm" />
    <source src="/videos/aurora-hero-loop.mp4" type="video/mp4" />
  </video>
  <h1>{t("description.title")}</h1>
  <h2>{t("description.how")}</h2>
  <p>{t("description.text1")}</p>
  <p>
    {t("description.text2")}
  </p>
</section>
